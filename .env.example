# Paridhan Environment Configuration Template

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Payments (Razorpay Route)
RAZORPAY_KEY_ID=rzp_test_xxxxxx
RAZORPAY_KEY_SECRET=your_secret_xxxxxx
RAZORPAY_ROUTE_ACCOUNT_ID=acc_xxxxxx

# Maps & Location
GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# Auth Providers
GOOGLE_OAUTH_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# Push Notifications
ONESIGNAL_APP_ID=your_onesignal_app_id
ONESIGNAL_API_KEY=your_onesignal_rest_api_key

# Communications
RESEND_API_KEY=re_xxxxxx
GUPSHUP_API_KEY=your_gupshup_api_key

# Artificial Intelligence
ANTHROPIC_API_KEY=sk-ant-xxxxxx

# Observability
SENTRY_DSN=https://xxxx@sentry.io/xxxx
POSTHOG_API_KEY=phc_xxxxxx
